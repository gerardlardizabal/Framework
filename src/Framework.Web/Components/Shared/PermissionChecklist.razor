@using Framework.Application.Identity

<div class="space-y-6">
    @if (Items.Count == 0)
    {
        <p class="text-sm text-gray-600">No permissions are defined yet.</p>
    }
    else
    {
        @foreach (var group in Items.GroupBy(item => item.Group))
        {
            <section>
                <h3 class="mb-3 text-sm font-semibold text-gray-900">@group.Key</h3>
                <div class="grid gap-3 sm:grid-cols-2">
                    @foreach (var permission in group)
                    {
                        var selected = Selected.Contains(permission.Name);
                        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 bg-white px-3.5 py-3 text-sm shadow-xs hover:border-brand-300 hover:bg-brand-25">
                            <input type="checkbox"
                                   class="mt-0.5 size-4 rounded border-gray-300 text-brand-600"
                                   checked="@selected"
                                   disabled="@Disabled"
                                   @onchange="e => Toggle(permission.Name, e.Value is true)" />
                            <span>
                                <span class="block font-medium text-gray-900">@permission.DisplayName</span>
                                <span class="block text-xs text-gray-600">@permission.Name</span>
                            </span>
                        </label>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<PermissionListItemDto> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<string> Selected { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<string>> SelectedChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task Toggle(string permission, bool isSelected)
    {
        var next = Selected.ToHashSet();
        if (isSelected)
        {
            next.Add(permission);
        }
        else
        {
            next.Remove(permission);
        }

        await SelectedChanged.InvokeAsync(next.ToArray());
    }
}
