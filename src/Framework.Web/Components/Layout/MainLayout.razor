@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar-backdrop" data-sidebar-backdrop></div>
<div class="app-shell">
    <NavMenu />
    <div class="flex min-h-screen flex-col bg-gray-50">
        <header class="flex h-16 items-center justify-between gap-3 border-b border-gray-200 bg-white px-4 sm:px-8">
            <div class="flex min-w-0 items-center gap-3">
                <button type="button"
                        class="inline-flex size-10 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-50 hover:text-gray-700 lg:hidden"
                        data-sidebar-drawer
                        aria-controls="app-sidebar"
                        aria-expanded="false"
                        aria-label="Open menu">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.67" aria-hidden="true">
                        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                </button>
                <p class="truncate text-sm text-gray-600">Clean Architecture · Identity · Permissions</p>
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="flex items-center gap-1 sm:gap-2">
                        <NotificationBell />
                        <AccountMenu Id="header"
                                     Placement="header"
                                     Name="@context.User.Identity?.Name"
                                     Email="@context.User.Identity?.Name"
                                     TriggerClass="account-menu-trigger"
                                     MetaClass="account-menu-meta hidden min-w-0 sm:block" />
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-secondary" href="Account/Login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>
        <main class="flex-1 px-4 py-8 sm:px-8">
            <div class="page-enter mx-auto max-w-6xl">
                <LoggingErrorBoundary>
                    @Body
                </LoggingErrorBoundary>
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Dismiss</span>
</div>
