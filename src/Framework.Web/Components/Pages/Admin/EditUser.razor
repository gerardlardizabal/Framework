@page "/admin/users/{Id:guid}"
@rendermode InteractiveServer
@using Framework.Application.Identity.Roles
@using Framework.Application.Identity.Users
@using MediatR
@attribute [HasPermission(Permissions.Users.Edit)]
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>Edit user</PageTitle>

<PageHeader Eyebrow="Users" Title="Edit user" Subtitle="Update profile details, roles, and account status." />

<DialogHost />
<AlertBanner Message="@message" IsError="isError" />

@if (model is null)
{
    <p class="text-sm text-gray-600">Loading…</p>
}
else
{
    <div class="card max-w-2xl">
        <p class="mb-6 text-sm text-gray-600">@model.Email</p>
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <div class="grid gap-4 sm:grid-cols-2">
                <label class="field">
                    <span class="field-label">First name</span>
                    <InputText class="field-input" @bind-Value="model.FirstName" />
                </label>
                <label class="field">
                    <span class="field-label">Last name</span>
                    <InputText class="field-input" @bind-Value="model.LastName" />
                </label>
            </div>
            <label class="mb-4 flex items-center gap-2 text-sm">
                <InputCheckbox @bind-Value="model.IsActive" class="size-4 rounded border-gray-300 text-brand-600" />
                Active
            </label>
            <fieldset class="mb-6">
                <legend class="mb-2 text-sm font-medium">Roles</legend>
                <div class="flex flex-wrap gap-3">
                    @foreach (var role in roles)
                    {
                        <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm shadow-xs">
                            <input type="checkbox" class="size-4 rounded border-gray-300 text-brand-600"
                                   checked="@model.Roles.Contains(role)"
                                   @onchange="e => ToggleRole(role, e.Value is true)" />
                            @role
                        </label>
                    }
                </div>
            </fieldset>
            <div class="flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary" disabled="@saving">Save changes</button>
                <a href="admin/users" class="btn btn-secondary">Back</a>
                <AuthorizeView Policy="@Permissions.Users.Delete" Context="auth">
                    <button type="button" class="btn btn-danger ml-auto" disabled="@saving" @onclick="DeleteAsync">Delete</button>
                </AuthorizeView>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private FormModel? model;
    private IReadOnlyList<string> roles = [];
    private string? message;
    private bool isError;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        roles = await Mediator.Send(new GetRoleNamesQuery());
        var user = await Mediator.Send(new GetUserQuery(Id));
        if (user is null)
        {
            Navigation.NavigateTo("admin/users");
            return;
        }

        model = new FormModel
        {
            Email = user.Email,
            FirstName = user.FirstName,
            LastName = user.LastName,
            IsActive = user.IsActive,
            Roles = user.Roles.ToHashSet()
        };
    }

    private void ToggleRole(string role, bool selected)
    {
        if (model is null)
        {
            return;
        }

        if (selected)
        {
            model.Roles.Add(role);
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private async Task SaveAsync()
    {
        if (model is null)
        {
            return;
        }

        saving = true;
        var result = await Mediator.Send(new UpdateUserCommand(
            Id,
            model.FirstName,
            model.LastName,
            model.IsActive,
            model.Roles.ToArray()));
        saving = false;

        isError = !result.Succeeded;
        message = result.Succeeded ? "User updated." : string.Join(" ", result.Errors);
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync(
            "Delete user?",
            "This account will be removed and they will no longer be able to sign in. This action cannot be undone.",
            kind: DialogKind.Error,
            confirmText: "Delete",
            destructive: true);
        if (!confirmed)
        {
            return;
        }

        saving = true;
        var result = await Mediator.Send(new DeleteUserCommand(Id));
        saving = false;

        if (result.Succeeded)
        {
            Navigation.NavigateTo("admin/users");
            return;
        }

        isError = true;
        message = string.Join(" ", result.Errors);
        await Dialogs.ShowMessageAsync("Couldn't delete user", message, DialogKind.Error);
    }

    private sealed class FormModel
    {
        public string Email { get; set; } = "";
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public bool IsActive { get; set; }
        public HashSet<string> Roles { get; set; } = [];
    }
}
